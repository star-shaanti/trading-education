# ---------------------------------------------------------------------------
# Trading Education — variables d'environnement
# Copier en `.env` pour le développement local, et renseigner dans Coolify
# (onglet Environment Variables) pour la production.
# ---------------------------------------------------------------------------

# --- Base de données PostgreSQL ---------------------------------------------
# PRODUCTION (Coolify) : service PostgreSQL interne → hôte = nom du service
# DATABASE_URL="postgresql://postgres:<mot-de-passe>@postgres:5432/trading?schema=public"
# DÉVELOPPEMENT local (docker compose up -d) :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading?schema=public"
# Variante Supabase (pooler) :
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://user:password@postgres:5432/trading?schema=public"

# --- Authentification (NextAuth) --------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="remplacer-par-un-secret-de-32-octets-minimum"
NEXTAUTH_URL="http://localhost:3000"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Emails transactionnels (Resend — palier gratuit 3000 emails/mois) -------
# Laisser vide en développement : les emails sont alors simplement journalisés.
RESEND_API_KEY=""
EMAIL_FROM="Trading Education <contact@tradingeducationpro.com>"
EMAIL_REPLY_TO="support@tradingeducationpro.com"

# --- Stockage des fichiers (PDF des rapports, images) -----------------------
# En production Coolify : monter un volume sur /app/storage
STORAGE_DIR="./storage"
# Taille maximale d'un upload d'image (Mo)
UPLOAD_IMAGE_MAX_MB="5"
# Taille maximale d'un PDF de rapport (Mo)
UPLOAD_PDF_MAX_MB="25"

# --- Administration ---------------------------------------------------------
ADMIN_EMAIL="admin@tradingeducationpro.com"
ADMIN_PASSWORD="ChangeMoi123!"
# Compte rédacteur (EDITOR) : accès limité aux contenus et à la modération
EDITOR_EMAIL="redacteur@tradingeducationpro.com"
EDITOR_PASSWORD="Redacteur123!"

# --- Sécurité / conformité --------------------------------------------------
# Sel utilisé pour anonymiser les adresses IP stockées dans les statistiques
IP_SALT="remplacer-par-une-chaine-aleatoire"
# Secret des tâches planifiées (newsletter hebdo + rappels de webinaires)
CRON_SECRET="remplacer-par-une-chaine-aleatoire"
